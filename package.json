{
  "name": "ai-autonomy-interfaces",
  "private": true,
  "version": "0.1.0",
  "description": "AI Autonomy R1 browser interface (aiautonomy/interfaces): Three.js scene, Preact panels, uPlot charts",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint aiautonomy/interfaces tests/interfaces eslint.config.js vite.config.ts vitest.config.ts playwright.config.ts && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:protocol": "node aiautonomy/interfaces/net/protocol.codegen.mjs",
    "check:protocol": "node aiautonomy/interfaces/net/protocol.codegen.mjs --check"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "three": "^0.187.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
